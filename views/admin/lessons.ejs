<%- include('../partials/top', { crumbs: [{ label: 'Quản trị', href: '/admin' }, { label: 'Khóa học', href: '/admin/courses' }, { label: course.title }] }) %>
<div class="page">
  <div class="page-head">
    <div>
      <h1 class="page-title"><%= course.title %></h1>
      <p class="muted"><%= lessons.length %> bài học · <a href="/admin/courses/<%= course.id %>/edit">Sửa thông tin khóa học</a> · <a href="/courses/<%= course.slug %>">Xem trang khóa học</a></p>
    </div>
    <a class="btn btn-primary" href="/admin/courses/<%= course.id %>/lessons/new"><svg class="i"><use href="#i-plus"/></svg>Thêm bài học</a>
  </div>

  <% if (!lessons.length) { %>
    <div class="empty"><svg class="i"><use href="#i-video"/></svg><h3>Chưa có bài học</h3><p><a href="/admin/courses/<%= course.id %>/lessons/new">Thêm bài học đầu tiên</a> với video YouTube hoặc file video.</p></div>
  <% } else { %>
    <ol class="admin-lessons">
      <% const typeLabel = { youtube: 'YouTube', upload: 'Video upload', none: 'Bài đọc' }; %>
      <% lessons.forEach((l, i) => { %>
        <li class="card admin-lesson" id="lesson-<%= l.id %>">
          <span class="num"><%= i + 1 %></span>
          <% const thumb = h.lessonThumb({ ...l, cover_image: course.cover_image }); %>
          <span class="admin-thumb" style="--c:<%= course.color %>"><% if (thumb) { %><img src="<%= thumb %>" alt="" loading="lazy"><% } else { %><svg class="i"><use href="#i-video"/></svg><% } %></span>
          <span class="body">
            <strong><%= l.title %></strong>
            <small class="muted"><%= typeLabel[l.video_type] %><%= l.video_ratio ? ' ' + l.video_ratio : '' %> · <%= l.duration_sec ? h.fmtDuration(l.duration_sec) : 'chưa có thời lượng' %></small>
            <% if (l.video_type === 'upload' && !l.video_ref) { %><span class="badge badge-warn upload-pending" data-pending-lesson="<%= l.id %>">Đang chờ video tải lên</span><% } %>
          </span>
          <div class="row-actions">
            <% [['up', 'Lên', 'i-arrow-up', i === 0], ['down', 'Xuống', 'i-arrow-down', i === lessons.length - 1]].forEach(([dir, label, icon, disabled]) => { %>
              <form method="post" action="/admin/lessons/<%= l.id %>/move">
                <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="dir" value="<%= dir %>">
                <button class="btn btn-sm btn-outline btn-icon" type="submit" aria-label="Chuyển “<%= l.title %>” <%= label.toLowerCase() %>" <%= disabled ? 'disabled' : '' %>><svg class="i"><use href="#<%= icon %>"/></svg></button>
              </form>
            <% }) %>
            <button class="btn btn-sm btn-outline" type="button" data-upload-lesson="<%= l.id %>" data-lesson-title="<%= l.title %>" title="Tải video cho bài này ở Trung tâm tải video"><svg class="i"><use href="#i-upload"/></svg>Tải video</button>
            <a class="btn btn-sm btn-outline" href="/admin/lessons/<%= l.id %>/edit"><svg class="i"><use href="#i-edit"/></svg>Sửa</a>
            <form method="post" action="/admin/lessons/<%= l.id %>/delete" data-confirm="Xóa bài học “<%= l.title %>”? Tiến độ của học viên ở bài này cũng bị xóa.">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <button class="btn btn-sm btn-outline btn-icon btn-danger" type="submit" aria-label="Xóa <%= l.title %>"><svg class="i"><use href="#i-trash"/></svg></button>
            </form>
          </div>
        </li>
      <% }) %>
    </ol>
  <% } %>
</div>
<%- include('../partials/bottom') %>
