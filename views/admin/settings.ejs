<%- include('../partials/top', { crumbs: [{ label: 'Quản trị', href: '/admin' }, { label: 'Cài đặt & Zalo' }] }) %>
<%
  const err = name => errors[name] ? `<p class="field-error" id="${name}-msg">${errors[name]}</p>` : '';
  const aria = name => errors[name] ? `aria-invalid="true" aria-describedby="${name}-msg"` : '';
%>
<div class="page page-narrow">
  <h1 class="page-title">Cài đặt</h1>

  <form method="post" action="/admin/settings?_csrf=<%= csrf %>" enctype="multipart/form-data" class="form card form-card" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">

    <h2 class="form-section">Thông tin website</h2>
    <div class="field-row">
      <div class="field">
        <label for="site_name">Tên website</label>
        <input id="site_name" name="site_name" maxlength="60" value="<%= values.site_name %>" placeholder="<%= defaultSiteName %>">
        <p class="field-hint">Hiện ở góc trên menu, tiêu đề tab trình duyệt và trang đăng nhập.</p>
      </div>
      <div class="field">
        <label for="site_tagline">Khẩu hiệu</label>
        <input id="site_tagline" name="site_tagline" maxlength="60" value="<%= values.site_tagline %>" placeholder="VD: Học làm video bằng AI">
        <p class="field-hint">Dòng chữ nhỏ cạnh tên. Để trống để ẩn.</p>
      </div>
    </div>
    <div class="field">
      <label for="hero_title">Tiêu đề trang chủ</label>
      <input id="hero_title" name="hero_title" maxlength="120" value="<%= values.hero_title %>">
      <p class="field-hint">Dòng chữ lớn ở đầu trang chủ. Để trống để dùng nội dung mặc định.</p>
    </div>
    <div class="field">
      <label for="hero_text">Mô tả trang chủ</label>
      <textarea id="hero_text" name="hero_text" rows="2" maxlength="300"><%= values.hero_text %></textarea>
    </div>
    <%- include('../partials/image-field', {
      name: 'site_logo', label: 'Logo (vuông)', current: values.site_logo, ratio: '1/1', error: errors.site_logo,
      hint: `Ảnh vuông, nền trong suốt càng tốt (PNG/WebP), ví dụ 256×256. Dùng làm logo và biểu tượng tab trình duyệt. Tối đa ${maxImageMb} MB.`,
    }) %>

    <h2 class="form-section">Lưu trữ video</h2>
    <div class="storage-box <%= storage.persistent ? 'is-safe' : 'is-risk' %>">
      <svg class="i"><use href="#<%= storage.persistent ? 'i-check-circle' : 'i-shield' %>"/></svg>
      <div>
        <% if (storage.persistent) { %>
          <strong>Video được lưu an toàn ngoài mã nguồn – không bị mất khi cập nhật website.</strong>
        <% } else if (storage.isProd) { %>
          <strong>Cảnh báo: video đang lưu trong thư mục mã nguồn và sẽ bị xóa mỗi lần cập nhật website.</strong>
        <% } else { %>
          <strong>Đang chạy thử trên máy: video lưu trong thư mục dự án.</strong>
        <% } %>
        <small class="d-block muted">Thư mục: <code><%= storage.dir %></code> · <%= storage.count %> video · <%= storage.mb %> MB</small>
      </div>
    </div>

    <h2 class="form-section">Hỗ trợ Zalo</h2>
    <p class="muted form-section-note">Khung hỗ trợ Zalo (thanh bên trái và nút tròn góc phải dưới) sẽ hiện khi bạn nhập số điện thoại, link Zalo <strong>hoặc chỉ cần upload ảnh mã QR</strong>.</p>

    <div class="field-row">
      <div class="field <%= errors.zalo_phone ? 'has-error' : '' %>">
        <label for="zalo_phone">Số điện thoại Zalo</label>
        <input id="zalo_phone" name="zalo_phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="09xx xxx xxx" value="<%= values.zalo_phone %>" <%- aria('zalo_phone') %>>
        <% if (errors.zalo_phone) { %><%- err('zalo_phone') %><% } else { %><p class="field-hint">Học viên bấm sẽ mở chat Zalo tới số này.</p><% } %>
      </div>
      <div class="field <%= errors.zalo_link ? 'has-error' : '' %>">
        <label for="zalo_link">Link Zalo OA / nhóm (không bắt buộc)</label>
        <input id="zalo_link" name="zalo_link" type="url" placeholder="https://zalo.me/..." value="<%= values.zalo_link %>" <%- aria('zalo_link') %>>
        <% if (errors.zalo_link) { %><%- err('zalo_link') %><% } else { %><p class="field-hint">Nếu nhập, nút “Nhắn Zalo” sẽ dùng link này thay cho số điện thoại.</p><% } %>
      </div>
    </div>

    <div class="field">
      <label for="support_title">Tiêu đề khung hỗ trợ</label>
      <input id="support_title" name="support_title" maxlength="80" value="<%= values.support_title %>">
    </div>
    <div class="field">
      <label for="support_text">Lời nhắn</label>
      <textarea id="support_text" name="support_text" rows="2" maxlength="300"><%= values.support_text %></textarea>
    </div>
    <div class="field">
      <label for="support_hours">Giờ hỗ trợ</label>
      <input id="support_hours" name="support_hours" maxlength="80" value="<%= values.support_hours %>">
    </div>

    <%- include('../partials/image-field', {
      name: 'zalo_qr', label: 'Ảnh mã QR Zalo (không bắt buộc)', current: values.zalo_qr, error: errors.zalo_qr, ratio: '1/1',
      hint: `Mở Zalo → Cá nhân → bấm vào mã QR → Lưu ảnh, rồi tải lên đây. Có thể dùng ảnh chụp màn hình: website tự cắt sát mã QR. Tối đa ${maxImageMb} MB.`,
    }) %>

    <h2 class="form-section">Thanh toán khóa chuyên sâu</h2>
    <p class="muted form-section-note">Tài khoản nhận tiền dùng để tạo mã <strong>VietQR</strong> (có sẵn số tiền và nội dung) cho mỗi đơn hàng.</p>
    <div class="field-row">
      <div class="field <%= errors.pay_bank_bin ? 'has-error' : '' %>">
        <label for="pay_bank_bin">Ngân hàng</label>
        <select id="pay_bank_bin" name="pay_bank_bin" <%- aria('pay_bank_bin') %>>
          <option value="">— Chọn ngân hàng —</option>
          <% banks.forEach(b => { %><option value="<%= b.bin %>" <%= values.pay_bank_bin === b.bin ? 'selected' : '' %>><%= b.name %></option><% }) %>
        </select>
        <%- err('pay_bank_bin') %>
      </div>
      <div class="field <%= errors.pay_account_no ? 'has-error' : '' %>">
        <label for="pay_account_no">Số tài khoản</label>
        <input id="pay_account_no" name="pay_account_no" inputmode="numeric" autocomplete="off" value="<%= values.pay_account_no %>" <%- aria('pay_account_no') %>>
        <%- err('pay_account_no') %>
      </div>
    </div>
    <div class="field-row">
      <div class="field grow">
        <label for="pay_account_name">Tên chủ tài khoản</label>
        <input id="pay_account_name" name="pay_account_name" maxlength="60" placeholder="NGUYEN VAN A" value="<%= values.pay_account_name %>">
        <p class="field-hint">Viết hoa không dấu, giống trên app ngân hàng – hiện cho học viên đối chiếu.</p>
      </div>
      <div class="field field-sm">
        <label for="pay_prefix">Tiền tố mã đơn</label>
        <input id="pay_prefix" name="pay_prefix" maxlength="8" value="<%= values.pay_prefix %>">
        <p class="field-hint">VD: BKAI → BKAI12</p>
      </div>
    </div>
    <p class="pay-test-note"><svg class="i i-sm"><use href="#i-shield"/></svg>Sau khi lưu, hãy tự tạo một đơn thử và <strong>quét mã bằng app ngân hàng</strong> để chắc chắn tên chủ tài khoản hiện đúng trước khi bán.</p>

    <label class="switch">
      <input type="checkbox" name="premium_sales_open" value="1" <%= values.premium_sales_open !== '0' ? 'checked' : '' %>>
      <span class="switch-ui" aria-hidden="true"></span>
      <span><strong>Đang mở bán khóa chuyên sâu</strong><small class="d-block muted">Tắt để tạm ngừng bán: ẩn cột khóa chuyên sâu và nút Mua. Học viên đã mua vẫn học bình thường.</small></span>
    </label>

    <label class="switch">
      <input type="checkbox" name="bundle_enabled" value="1" <%= values.bundle_enabled === '1' ? 'checked' : '' %>>
      <span class="switch-ui" aria-hidden="true"></span>
      <span><strong>Bán gói trọn bộ</strong><small class="d-block muted">Một lần thanh toán, mở tất cả khóa chuyên sâu (kể cả khóa thêm sau này).</small></span>
    </label>
    <div class="field-row">
      <div class="field grow">
        <label for="bundle_title">Tên gói</label>
        <input id="bundle_title" name="bundle_title" maxlength="120" value="<%= values.bundle_title %>">
      </div>
      <div class="field field-price <%= errors.bundle_price ? 'has-error' : '' %>">
        <label for="bundle_price">Giá gói (VNĐ)</label>
        <div class="input-suffix"><input id="bundle_price" name="bundle_price" inputmode="numeric" placeholder="VD: 1990000" value="<%= values.bundle_price %>" <%- aria('bundle_price') %>><span>đ</span></div>
        <%- err('bundle_price') %>
      </div>
    </div>
    <div class="field">
      <label for="bundle_description">Mô tả gói</label>
      <textarea id="bundle_description" name="bundle_description" rows="2" maxlength="300"><%= values.bundle_description %></textarea>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit" data-loading-text="Đang lưu...">Lưu cài đặt</button>
    </div>
  </form>
</div>
<%- include('../partials/bottom', { scripts: ['/js/vendor/jsQR.js', '/js/admin.js'] }) %>
