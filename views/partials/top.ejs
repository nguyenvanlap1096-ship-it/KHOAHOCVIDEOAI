<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrf %>">
  <title><%= locals.title ? title + ' · ' : '' %><%= siteName %></title>
  <meta name="description" content="<%= siteName %> – nền tảng học lập trình và thiết kế trực tuyến.">
  <link rel="icon" href="/img/logo.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<a class="skip-link" href="#content">Bỏ qua đến nội dung chính</a>
<%- include('icons') %>
<div class="app" id="app">
  <%- include('rail') %>
  <%- include('panel') %>
  <div class="scrim" id="scrim"></div>

  <main>
    <header class="topbar">
      <button class="btn btn-outline btn-icon menu-btn" id="menuBtn" type="button" aria-label="Mở menu" aria-controls="panel" aria-expanded="false">
        <svg class="i"><use href="#i-menu"/></svg>
      </button>
      <% if (locals.crumbs && crumbs.length) { %>
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <% crumbs.forEach((c, i) => { const last = i === crumbs.length - 1; %>
              <li>
                <% if (last) { %>
                  <span class="current" aria-current="page"><%= c.label %></span>
                <% } else { %>
                  <% if (i === 0) { %><svg class="i i-sm"><use href="#i-folder"/></svg><% } %>
                  <a href="<%= c.href %>"><%= c.label %></a>
                  <svg class="i sep"><use href="#i-chevron-right"/></svg>
                <% } %>
              </li>
            <% }) %>
          </ol>
        </nav>
      <% } %>
      <div class="right">
        <% if (user) { %>
          <a class="user-chip" href="/my" title="<%= user.email %>">
            <span class="avatar"><%= h.initials(user.name) %></span>
            <span class="user-name"><%= user.name %></span>
          </a>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="btn btn-outline" type="submit"><svg class="i"><use href="#i-log-out"/></svg><span class="hide-sm">Đăng xuất</span></button>
          </form>
        <% } else { %>
          <a class="btn btn-ghost" href="/login?next=<%= encodeURIComponent(path) %>">Đăng nhập</a>
          <a class="btn btn-primary" href="/register">Đăng ký</a>
        <% } %>
      </div>
    </header>

    <div id="content" tabindex="-1">
    <% if (flash) { %>
      <div class="flash flash-<%= flash.type %>" role="<%= flash.type === 'error' ? 'alert' : 'status' %>">
        <svg class="i"><use href="#<%= flash.type === 'error' ? 'i-x' : 'i-check-circle' %>"/></svg>
        <span><%= flash.message %></span>
        <button type="button" class="flash-close" aria-label="Đóng thông báo"><svg class="i"><use href="#i-x"/></svg></button>
      </div>
    <% } %>
