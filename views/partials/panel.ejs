<aside class="panel" id="panel" aria-label="Menu khóa học">
  <div class="panel-head"><span class="panel-name"><%= siteName %></span><% if (siteTagline) { %> <span class="muted"><%= siteTagline %></span><% } %></div>
  <form class="search" action="/" method="get" role="search">
    <svg class="i"><use href="#i-search"/></svg>
    <label for="panelSearch" class="sr-only">Tìm khóa học</label>
    <input type="search" id="panelSearch" name="q" placeholder="Tìm khóa học..." value="<%= locals.q || '' %>">
  </form>

  <a class="nav-item" href="/" <%- path === '/' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-grid"/></svg><span class="t">Tất cả khóa học</span></a>
  <a class="nav-item" href="/videos" <%- path === '/videos' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-video"/></svg><span class="t">Video mới cập nhật</span></a>
  <a class="nav-item" href="/prompts" <%- path.startsWith('/prompts') ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-sparkles"/></svg><span class="t">Prompt theo ngành nghề</span></a>
  <a class="nav-item" href="/my" <%- path === '/my' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-clock"/></svg><span class="t">Đang học</span></a>
  <a class="nav-item" href="/my#saved"><svg class="i"><use href="#i-bookmark"/></svg><span class="t">Đã lưu</span></a>

  <% if (user && user.role === 'admin') { %>
    <button class="section-toggle" type="button" aria-expanded="true" aria-controls="sec-admin">Quản trị<svg class="i chev"><use href="#i-chevron-down"/></svg></button>
    <div class="section-body" id="sec-admin">
      <a class="nav-item" href="/admin" <%- locals.adminNav === 'dashboard' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-shield"/></svg><span class="t">Tổng quan</span></a>
      <a class="nav-item" href="/admin/courses" <%- locals.adminNav === 'courses' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-layers"/></svg><span class="t">Khóa học &amp; bài học</span></a>
      <a class="nav-item" href="/admin/prompts" <%- locals.adminNav === 'prompts' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-sparkles"/></svg><span class="t">Prompt &amp; ngành nghề</span></a>
      <a class="nav-item" href="/admin/users" <%- locals.adminNav === 'users' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-users"/></svg><span class="t">Người dùng</span></a>
      <a class="nav-item" href="/admin/settings" <%- locals.adminNav === 'settings' ? 'aria-current="true"' : '' %>><svg class="i"><use href="#i-settings"/></svg><span class="t">Cài đặt &amp; Zalo</span></a>
    </div>
  <% } %>

  <% if (sidebar.learning.length) { %>
    <button class="section-toggle" type="button" aria-expanded="true" aria-controls="sec-learning">Đang học <span class="chip"><%= sidebar.learning.length %></span><svg class="i chev"><use href="#i-chevron-down"/></svg></button>
    <div class="section-body" id="sec-learning">
      <% sidebar.learning.forEach(c => { %>
        <a class="nav-item" href="/learn/<%= c.slug %>"><span class="dot" style="background:<%= c.color %>"></span><span class="t"><%= c.title %></span></a>
      <% }) %>
    </div>
  <% } %>

  <% if (sidebar.saved.length) { %>
    <button class="section-toggle" type="button" aria-expanded="true" aria-controls="sec-saved">Đã lưu <span class="chip"><%= sidebar.saved.length %></span><svg class="i chev"><use href="#i-chevron-down"/></svg></button>
    <div class="section-body" id="sec-saved">
      <% sidebar.saved.forEach(c => { %>
        <a class="nav-item" href="/courses/<%= c.slug %>"><span class="fav-ico" style="background:<%= c.color %>"><%= h.coverLabel(c.title) %></span><span class="t"><%= c.title %></span></a>
      <% }) %>
    </div>
  <% } %>

  <div class="promo-card">
    <% if (!user) { %>
      <h3>Bắt đầu hành trình Video AI</h3>
      <p>Đăng ký tài khoản để lưu tiến độ, đánh dấu khóa học yêu thích và học tiếp trên mọi thiết bị.</p>
      <a class="btn-soft" href="/register">Đăng ký ngay <svg class="i i-sm"><use href="#i-arrow-right"/></svg></a>
    <% } else if (user.role === 'admin') { %>
      <h3>Thêm nội dung mới</h3>
      <p>Tạo khóa học, thêm video YouTube hoặc tự upload bài giảng.</p>
      <a class="btn-soft" href="/admin/courses/new">Thêm khóa học <svg class="i i-sm"><use href="#i-arrow-right"/></svg></a>
    <% } else { %>
      <h3>Tiếp tục hành trình</h3>
      <p>Mỗi ngày một bài học nhỏ sẽ tạo nên khác biệt lớn.</p>
      <a class="btn-soft" href="/my">Khóa học của tôi <svg class="i i-sm"><use href="#i-arrow-right"/></svg></a>
    <% } %>
  </div>

  <% if (locals.support) { %>
    <section class="zalo-side" aria-labelledby="zaloSideTitle">
      <div class="zalo-side-head">
        <span class="zalo-badge" aria-hidden="true">Zalo</span>
        <div>
          <h3 id="zaloSideTitle"><%= support.title %></h3>
          <% if (support.hours) { %><p><span class="dot-online" aria-hidden="true"></span><%= support.hours %></p><% } %>
        </div>
      </div>
      <% if (support.qr) { %>
        <figure class="zalo-side-qr">
          <img src="<%= h.imageUrl(support.qr) %>" alt="Mã QR Zalo hỗ trợ học viên" width="168" height="168" loading="lazy">
          <figcaption>Quét mã bằng ứng dụng Zalo</figcaption>
        </figure>
      <% } else if (support.text) { %>
        <p class="zalo-side-text"><%= support.text %></p>
      <% } %>
      <a class="btn btn-zalo btn-sm btn-block" href="<%= support.url %>" target="_blank" rel="noopener noreferrer"><svg class="i"><use href="#i-message"/></svg>Nhắn Zalo</a>
      <% if (support.phone) { %>
        <a class="zalo-side-phone" href="tel:<%= support.phone %>"><svg class="i i-sm"><use href="#i-phone"/></svg><%= support.phoneDisplay %></a>
      <% } %>
    </section>
  <% } %>
</aside>
