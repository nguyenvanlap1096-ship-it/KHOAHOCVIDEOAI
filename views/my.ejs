<%- include('partials/top', { crumbs: [{ label: 'Khóa học', href: '/' }, { label: 'Khóa học của tôi' }] }) %>
<div class="page">
  <h1 class="page-title">Khóa học của tôi</h1>
  <%- include('partials/muse-promo') %>
  <%- include('partials/studio-promo') %>

  <% if (owned.length) { %>
    <section class="section" id="premium">
      <h2 class="section-title"><svg class="i"><use href="#i-crown"/></svg> Khóa chuyên sâu đã mua <span class="chip"><%= owned.length %></span></h2>
      <div class="course-grid"><% owned.forEach(c => { %><%- include('partials/course-card', { course: c }) %><% }) %></div>
    </section>
  <% } %>

  <section class="section" id="learning">
    <h2 class="section-title">Đang học <span class="chip"><%= inProgress.length %></span></h2>
    <% if (inProgress.length) { %>
      <div class="course-grid"><% inProgress.forEach(c => { %><%- include('partials/course-card', { course: c }) %><% }) %></div>
    <% } else { %>
      <div class="empty"><svg class="i"><use href="#i-book-open"/></svg><h3>Bạn chưa bắt đầu khóa học nào</h3><p><a href="/">Khám phá khóa học</a> và bắt đầu bài học đầu tiên.</p></div>
    <% } %>
  </section>

  <section class="section" id="saved">
    <h2 class="section-title">Đã lưu <span class="chip"><%= saved.length %></span></h2>
    <% if (saved.length) { %>
      <div class="course-grid"><% saved.forEach(c => { %><%- include('partials/course-card', { course: c }) %><% }) %></div>
    <% } else { %>
      <p class="muted">Nhấn biểu tượng <svg class="i i-sm"><use href="#i-bookmark"/></svg> ở trang khóa học để lưu lại xem sau.</p>
    <% } %>
  </section>

  <% if (completed.length) { %>
    <section class="section">
      <h2 class="section-title">Đã hoàn thành <span class="chip"><%= completed.length %></span></h2>
      <div class="course-grid"><% completed.forEach(c => { %><%- include('partials/course-card', { course: c }) %><% }) %></div>
    </section>
  <% } %>
  <% if (orders.length) { %>
    <section class="section" id="orders">
      <h2 class="section-title">Đơn hàng của tôi <span class="chip"><%= orders.length %></span></h2>
      <div class="table-wrap card">
        <table class="table">
          <thead><tr><th>Mã đơn</th><th>Khóa học</th><th>Số tiền</th><th>Ngày đặt</th><th>Trạng thái</th></tr></thead>
          <tbody>
            <% orders.forEach(o => { %>
              <tr>
                <td><a class="link" href="/orders/<%= o.id %>"><%= o.transfer_code %></a></td>
                <td><%= o.item_title %></td>
                <td><%= vnd(o.amount) %></td>
                <td><%= h.fmtDateTime(o.created_at) %></td>
                <td><span class="badge order-status status-<%= o.status %>"><%= ORDER_STATUS[o.status] %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>
</div>
<% if (user.role !== 'admin') { %>
<div class="page page-tail">
  <section class="section account-box card" id="account" aria-labelledby="accountTitle">
    <div class="account-head">
      <span class="pending-ico" aria-hidden="true"><svg class="i"><use href="#i-lock"/></svg></span>
      <div>
        <h2 id="accountTitle">Tài khoản & mật khẩu</h2>
        <p class="muted"><%= user.name %> · <%= h.contactOf(user.email) %></p>
      </div>
    </div>
    <form method="post" action="/account/password" class="form account-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% [['current_password', 'Mật khẩu hiện tại', 'current-password'], ['password', 'Mật khẩu mới (ít nhất 8 ký tự)', 'new-password'], ['password_confirm', 'Nhập lại mật khẩu mới', 'new-password']].forEach(([n, label, ac]) => { %>
        <div class="field">
          <label for="acc-<%= n %>"><%= label %></label>
          <div class="password-wrap">
            <input id="acc-<%= n %>" name="<%= n %>" type="password" autocomplete="<%= ac %>" required>
            <button type="button" class="pw-toggle" data-pw-toggle="acc-<%= n %>" aria-label="Hiện mật khẩu"><svg class="i"><use href="#i-eye"/></svg></button>
          </div>
        </div>
      <% }) %>
      <button class="btn btn-primary" type="submit">Đổi mật khẩu</button>
    </form>
  </section>
</div>
<% } %>
<%- include('partials/bottom') %>
