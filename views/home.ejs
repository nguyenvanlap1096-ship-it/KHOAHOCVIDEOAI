<%- include('partials/top', { crumbs: [{ label: 'Khóa học', href: '/' }, { label: 'Khám phá' }] }) %>
<div class="page">
  <section class="hero">
    <div>
      <h1><%= user ? `Chào ${user.name.split(' ').slice(-1)[0]}, hôm nay học gì?` : 'Học lập trình & thiết kế theo cách của bạn' %></h1>
      <p>Bài giảng video ngắn gọn, tóm tắt rõ ràng và theo dõi tiến độ tự động cho từng bài học.</p>
    </div>
    <form class="hero-search" action="/" method="get" role="search">
      <label for="q" class="sr-only">Tìm khóa học</label>
      <svg class="i"><use href="#i-search"/></svg>
      <input id="q" type="search" name="q" value="<%= q %>" placeholder="Tìm theo tên, chủ đề...">
      <% if (level) { %><input type="hidden" name="level" value="<%= level %>"><% } %>
      <button class="btn btn-primary" type="submit">Tìm kiếm</button>
    </form>
  </section>

  <% if (continueLearning.length) { %>
    <section class="section">
      <h2 class="section-title">Tiếp tục học</h2>
      <div class="continue-list">
        <% continueLearning.forEach(c => { %>
          <a class="continue-item" href="/learn/<%= c.slug %>">
            <%- include('partials/ring', { value: c.percent, cls: 'ring-sm' }) %>
            <span class="body"><strong><%= c.title %></strong><small><%= c.lesson_count %> bài · <%= c.level %></small></span>
            <svg class="i"><use href="#i-arrow-right"/></svg>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="section">
    <div class="section-head">
      <h2 class="section-title"><%= q ? `Kết quả cho “${q}”` : 'Tất cả khóa học' %> <span class="chip"><%= courses.length %></span></h2>
      <nav class="filter-chips" aria-label="Lọc theo trình độ">
        <% ['', ...h.LEVELS].forEach(lv => { const qs = new URLSearchParams(Object.assign({}, q ? { q } : {}, lv ? { level: lv } : {})).toString(); %>
          <a class="filter-chip" href="/<%= qs ? '?' + qs : '' %>" <%- level === lv ? 'aria-current="true"' : '' %>><%= lv || 'Tất cả' %></a>
        <% }) %>
      </nav>
    </div>

    <% if (courses.length) { %>
      <div class="course-grid">
        <% courses.forEach(c => { %><%- include('partials/course-card', { course: c }) %><% }) %>
      </div>
    <% } else { %>
      <div class="empty">
        <svg class="i"><use href="#i-search"/></svg>
        <h3>Không tìm thấy khóa học phù hợp</h3>
        <p>Thử từ khóa khác hoặc <a href="/">xem tất cả khóa học</a>.</p>
      </div>
    <% } %>
  </section>
</div>
<%- include('partials/bottom') %>
