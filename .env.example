# ===== Demia – biến môi trường =====
# Sao chép file này thành .env rồi điền giá trị. KHÔNG đưa .env lên GitHub.

NODE_ENV=production
PORT=3000
SITE_NAME=Demia

# Chuỗi ngẫu nhiên dài (≥ 32 ký tự) dùng để ký cookie đăng nhập.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ----- MySQL (Hostinger: hPanel → Databases → MySQL Databases) -----
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Chạy thử trên máy không có MySQL: đặt DB_CLIENT=sqlite và bỏ trống phần MySQL.
# SQLITE_FILE=data/dev.sqlite

# ----- Tài khoản quản trị đầu tiên -----
# Tự tạo khi khởi động nếu email này chưa tồn tại. Đổi mật khẩu mạnh, riêng tư.
ADMIN_NAME=Quản trị viên
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ----- Video upload -----
# Thư mục lưu video. Nên đặt NGOÀI thư mục mã nguồn để không bị mất khi deploy lại.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500
